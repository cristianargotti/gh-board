{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Snapshot of the board for a prompt: rules, sprint, my items, attention, triage, epics, deliveries Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "default": 1500,
            "description": "approximate token budget of the snapshot",
            "type": "integer"
          },
          "for": {
            "description": "login whose open items fill the my items section (default: the viewer)",
            "type": "string"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "context",
      "title": "board context"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Board overview: items per status, sprint and alert counts Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "status",
      "title": "board status"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
