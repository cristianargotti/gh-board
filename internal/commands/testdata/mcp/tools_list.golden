            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "ref": {
            "description": "Issue reference: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "name": "close",
      "title": "board close"
    },
