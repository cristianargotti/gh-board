      },
      "description": "Overdue, blocked, triage past SLA, WIP exceeded and the other alert rules Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "attention",
      "title": "board attention"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Epics and milestones on a month timeline with the sprint iterations as markers Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "months": {
            "default": 3,
            "description": "months on the timeline, starting with the current one",
            "type": "integer"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "roadmap",
      "title": "board roadmap"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "One issue with its board fields, parent, sub-issue progress, blockers and dates Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "ref": {
            "description": "Issue reference: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "name": "item",
      "title": "board item"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "List items with the filters of section 7; --all reads every page Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "read every page",
            "type": "boolean"
          },
          "assignee": {
            "description": "assignee login",
            "type": "string"
          },
          "blocked": {
            "description": "only blocked items",
            "type": "boolean"
          },
          "epic": {
            "description": "epic value (capabilities.epic.field)",
            "type": "string"
          },
          "label": {
            "description": "label name",
            "type": "string"
          },
          "lane": {
            "description": "lane option name (capabilities.lane)",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "items per page without --all",
            "type": "integer"
          },
          "overdue": {
            "description": "only items past their target date (capabilities.dates)",
            "type": "boolean"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "sprint": {
            "description": "iteration title, current or next (capabilities.sprint)",
            "type": "string"
          },
          "status": {
            "description": "status option name",
            "type": "string"
          },
          "triage": {
            "description": "only undecided triage entries (capabilities.triage)",
            "type": "boolean"
          },
          "type": {
            "description": "issue type name",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list",
      "title": "board list"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Find items whose title, body, reference or labels contain the query Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "query": {
            "description": "Text searched in titles, bodies and labels of the board items",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search",
      "title": "board search"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Open epics with sub-issue progress, dates and owner Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "epics",
      "title": "board epics"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Inspect the current or next sprint, or set an item's sprint Read tool: no side effects.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "which": {
            "default": "current",
            "description": "subcommand to run: current or next",
            "enum": [
              "current",
              "next"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "sprint",
      "title": "board sprint"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Move work, saving a plan for a done status Direct write: journaled and reversible. dry_run shows the change without sending it, reason is stored in the audit line and expect refuses the write when a current value differs (exit code 4). A done status or a bulk above the team threshold returns a plan instead of writing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "show the write without sending it",
            "type": "boolean"
          },
          "expect": {
            "description": "precondition field=value for a write",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "ref": {
            "description": "Issue references separated by commas: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          },
          "status": {
            "description": "Target status option as the board names it; a done status turns the call into a plan",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "status"
        ],
        "type": "object"
      },
      "name": "move",
      "title": "board move"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Add an assignee Direct write: journaled and reversible. dry_run shows the change without sending it, reason is stored in the audit line and expect refuses the write when a current value differs (exit code 4). A done status or a bulk above the team threshold returns a plan instead of writing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "show the write without sending it",
            "type": "boolean"
          },
          "expect": {
            "description": "precondition field=value for a write",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "login": {
            "description": "GitHub login of the person to add, with or without the leading @",
            "type": "string"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "ref": {
            "description": "Issue references separated by commas: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "login"
        ],
        "type": "object"
      },
      "name": "assign",
      "title": "board assign"
    },
