    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Set project fields; status uses move policy Direct write: journaled and reversible. dry_run shows the change without sending it, reason is stored in the audit line and expect refuses the write when a current value differs (exit code 4). A done status or a bulk above the team threshold returns a plan instead of writing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "show the write without sending it",
            "type": "boolean"
          },
          "expect": {
            "description": "precondition field=value for a write",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fields": {
            "description": "Field assignments as field=value, one per entry, with the field and option names the board uses; the status field follows the move policy",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "ref": {
            "description": "Issue references separated by commas: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "fields"
        ],
        "type": "object"
      },
      "name": "set",
      "title": "board set"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Add a comment from text, a file, or standard input Direct write: journaled and reversible. dry_run shows the change without sending it, reason is stored in the audit line and expect refuses the write when a current value differs (exit code 4). A done status or a bulk above the team threshold returns a plan instead of writing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "description": "show the write without sending it",
            "type": "boolean"
          },
          "expect": {
            "description": "precondition field=value for a write",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "ref": {
            "description": "Issue references separated by commas: owner/repo#n, a GitHub URL or a node id; #n alone works when board.yml names a repository and one item carries that number",
            "type": "string"
          },
          "text": {
            "description": "Comment body in PT-BR, Markdown allowed; @path reads a file",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "text"
        ],
        "type": "object"
      },
      "name": "comment",
      "title": "board comment"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create an issue and add it to the project Direct write: journaled and reversible. dry_run shows the change without sending it, reason is stored in the audit line and expect refuses the write when a current value differs (exit code 4). A done status or a bulk above the team threshold returns a plan instead of writing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "description": "assignee login, repeatable or comma separated",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "body": {
            "description": "body text, file path, @file, or - for standard input",
            "type": "string"
          },
          "dry_run": {
            "description": "show the write without sending it",
            "type": "boolean"
          },
          "epic": {
            "description": "configured epic field value",
            "type": "string"
          },
          "estimate": {
            "description": "estimate in days",
            "type": "string"
          },
          "expect": {
            "description": "precondition field=value for a write",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "description": "What to create: task (the configured task type), epic (the configured epic type) or entry (a task carrying the triage label)",
            "enum": [
              "task",
              "epic",
              "entry"
            ],
            "type": "string"
          },
          "label": {
            "description": "label name, repeatable or comma separated",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "lane": {
            "description": "configured lane value",
            "type": "string"
          },
          "milestone": {
            "description": "repository milestone title",
            "type": "string"
          },
          "parent": {
            "description": "parent issue reference",
            "type": "string"
          },
          "project": {
            "description": "project as owner/number, overrides board.yml",
            "type": "string"
          },
          "reason": {
            "description": "reason stored in the audit line",
            "type": "string"
          },
          "sprint": {
            "description": "current, next, or iteration title",
            "type": "string"
          },
          "start": {
            "description": "start date, YYYY-MM-DD",
            "type": "string"
          },
          "target": {
            "description": "target date, YYYY-MM-DD",
            "type": "string"
          },
          "title": {
            "description": "issue title",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "name": "new",
      "title": "board new"
    },
    {
