{
  "families": [
    {
      "id": "project",
      "description": "GitHub CLI write subcommands on projects",
      "patterns": [
        "gh project close *",
        "gh project copy *",
        "gh project create *",
        "gh project delete *",
        "gh project edit *",
        "gh project field-create *",
        "gh project field-delete *",
        "gh project item-add *",
        "gh project item-archive *",
        "gh project item-create *",
        "gh project item-delete *",
        "gh project item-edit *",
        "gh project link *",
        "gh project mark-template *",
        "gh project unlink *"
      ]
    },
    {
      "id": "cli",
      "description": "Destructive GitHub CLI commands on issues, repositories and labels, and the kit verbs reserved to humans",
      "patterns": [
        "gh issue delete *",
        "gh issue transfer *",
        "gh repo delete *",
        "gh label delete *",
        "gh board apply *",
        "gh board agent uninstall *",
        "gh board guard uninstall *",
        "gh-board apply *",
        "gh-board agent uninstall *",
        "gh-board guard uninstall *",
        "*/gh-board apply*",
        "*/gh-board agent uninstall*",
        "*/gh-board guard uninstall*",
        "gh extension exec board apply *",
        "gh extension exec board agent uninstall *",
        "gh extension exec board guard uninstall *",
        "gh extensions exec board apply *",
        "gh extensions exec board agent uninstall *",
        "gh extensions exec board guard uninstall *",
        "gh ext exec board apply *",
        "gh ext exec board agent uninstall *",
        "gh ext exec board guard uninstall *",
        "gh extension remove board *",
        "gh extension remove gh-board *",
        "gh extensions remove board *",
        "gh extensions remove gh-board *",
        "gh ext remove board *",
        "gh ext remove gh-board *"
      ]
    },
    {
      "id": "api",
      "description": "GraphQL or REST bodies naming a forbidden mutation or the DELETE method",
      "patterns": [
        "gh api -X DELETE *",
        "gh api * -X DELETE*",
        "gh api -XDELETE *",
        "gh api * -XDELETE*",
        "gh api -X=DELETE *",
        "gh api * -X=DELETE*",
        "gh api --method DELETE *",
        "gh api * --method DELETE*",
        "gh api --method=DELETE *",
        "gh api * --method=DELETE*",
        "gh api *deleteProjectV2StatusUpdate*",
        "gh api *deleteProjectV2Workflow*",
        "gh api *deleteProjectV2Field*",
        "gh api *deleteProjectV2Item*",
        "gh api *deleteProjectV2View*",
        "gh api *deleteProjectV2*",
        "gh api *archiveProjectV2Item*",
        "gh api *clearProjectV2ItemFieldValue*",
        "gh api *updateProjectV2Collaborators*",
        "gh api *updateProjectV2Field*",
        "gh api *updateProjectV2*",
        "gh api *unlinkProjectV2FromRepository*",
        "gh api *unmarkProjectV2AsTemplate*",
        "gh api *deleteIssueFieldValue*",
        "gh api *deleteIssueComment*",
        "gh api *deleteIssueField*",
        "gh api *deleteIssueType*",
        "gh api *deleteIssue*",
        "gh api *transferIssue*",
        "gh api *removeSubIssue*",
        "gh api *updateIssueComment*",
        "gh api *deleteLabel*",
        "gh api *deleteMilestone*"
      ]
    }
  ],
  "strict": {
    "id": "strict",
    "description": "Opt-in strict mode: shell wrappers, absolute paths and file bodies the normal rules cannot see",
    "patterns": [
      "sh -c *",
      "sh -lc *",
      "bash -c *",
      "bash -lc *",
      "zsh -c *",
      "zsh -lc *",
      "dash -c *",
      "ksh -c *",
      "fish -c *",
      "pwsh -c *",
      "pwsh -Command *",
      "powershell -c *",
      "powershell -Command *",
      "cmd /c *",
      "eval *",
      "*/gh *",
      "env gh *",
      "env * gh *",
      "*/env gh *",
      "*/env * gh *",
      "xargs * gh *",
      "gh api --input *",
      "gh api * --input *",
      "gh api --input=*",
      "gh api * --input=*",
      "gh api *graphql*@*",
      "gh api *@*graphql*"
    ]
  }
}
